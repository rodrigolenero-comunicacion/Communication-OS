# Copia como .env.local (no se versiona) y en Netlify → Site configuration → Environment variables.
# Valores en Supabase → Project Settings → API. Usa la clave PUBLICABLE (o la anon legacy).
# Nunca pongas aquí la service_role / secret key: la app no la usa.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# V0.4 Generador editorial (solo servidor; nunca con prefijo NEXT_PUBLIC_). Sin ella: «Generación no configurada.»
# Clave de console.anthropic.com → API keys. El costo corre por cuenta del propietario.
ANTHROPIC_API_KEY=
# Opcionales:
# GENERATION_MODEL=claude-sonnet-5-5
# GENERATION_TIMEOUT_MS=55000
